{
  "name": "vectr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build -w @vectr/core && npm run build -w vectr-mcp-server && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && npm run typecheck -w @vectr/core && npm run typecheck -w vectr-mcp-server",
    "test": "vitest run",
    "vectr": "node packages/core/dist/cli.js",
    "mcp": "npm run build -w @vectr/core && npm run build -w vectr-mcp-server"
  },
  "dependencies": {
    "@vectr/core": "*",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "packages/*"
  ]
}
